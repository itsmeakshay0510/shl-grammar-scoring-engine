# ==============================================================
# SHL Grammar Scoring Engine — .gitignore
# ==============================================================

# ------ Competition data (never commit raw audio) ------
data/raw/
data/metadata/

# ------ Expensive cached representations ------
# These are regenerated from raw data + config.
# Commit only manifest.json files inside cache dirs, not the data.
cache/audio/
cache/asr/
cache/text/
cache/acoustic/
cache/embeddings/

# ------ Model weights downloaded at runtime ------
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.onnx

# ------ Outputs (predictions, plots) ------
# Large prediction files and figures are not tracked.
# Submission CSVs are tracked explicitly if small.
outputs/predictions/*.csv
outputs/plots/
outputs/reports/

# ------ Python ------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST

# ------ Virtual environments ------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------ Jupyter notebooks ------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ------ IDE / OS ------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
tempCodeRunnerFile.py

# ------ Secrets ------
.env
.envrc
*.key
*.pem
secrets.json
.pypirc

# ------ Experiment artifacts ------
# Keep experiment_log.csv tracked — it's the project record.
# But don't track large intermediate model files.
experiments/*.pkl
experiments/*.joblib
experiments/*.h5

# ------ Tooling & Linters ------
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
